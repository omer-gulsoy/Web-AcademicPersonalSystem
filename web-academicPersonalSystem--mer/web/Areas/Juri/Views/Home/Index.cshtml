@{
	ViewData["Title"] = "Jüri Paneli";
	Layout = "~/Areas/Juri/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Jüri Paneli /</span> Anasayfa </h4>
	<hr class="my-5" />
	<div class="row">
		<!-- Total Revenue -->
		<div class="col-12 col-lg-8 order-2 order-md-3 order-lg-2 mb-4">
			<div class="card">

				<!-- Striped Rows -->
				<div class="card">
					<h5 class="card-header"><i class="menu-icon tf-icons bx bx-edit"></i>Başvuru Listesi</h5>
					<div class="table-responsive text-nowrap">
						<table style="text-align:center" class="table table-striped">
							<thead>
								<tr>
									<th>İSİM SOYİSİM</th>
									<th>E-POSTA ADRESİ</th>
									<th>TELEFON NUMARASI</th>
									<th>BAŞVURDUĞU İLAN</th>
								</tr>
							</thead>
							<tbody class="table-border-bottom-0">
								@foreach (var satir in ViewBag.Basvurular)
								{
									<tr>
										<td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@satir.Basvuru.Personel.Isim @satir.Basvuru.Personel.Soyisim</strong></td>
										<td>
											<a href="mailto:@satir.Personel.Eposta">
												@satir.Basvuru.Personel.Eposta
											</a>
										</td>
										<td>
											<a href="tel:@satir.Personel.Telefon">
												@satir.Basvuru.Personel.Telefon
											</a>
										</td>
										<td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@satir.Basvuru.Ilan.Baslik</strong></td>
									</tr>
								}

							</tbody>
						</table>
					</div>
				</div>
				<!--/ Striped Rows -->
			</div>
		</div>
		<!--/ Total Revenue -->
		<div class="col-md-6 col-lg-4 order-2 mb-4">
			<div class="card h-100">
				<div class="card-header d-flex align-items-center justify-content-between">
					<h5 class="card-title m-0 me-2"><i class="menu-icon tf-icons bx bx-user"></i>Değerlendirmelerim</h5>
					<div class="dropdown">
						<button class="btn p-0"
								type="button"
								id="transactionID"
								data-bs-toggle="dropdown"
								aria-haspopup="true"
								aria-expanded="false">
							<i class="bx bx-dots-vertical-rounded"></i>
						</button>
						<div class="dropdown-menu dropdown-menu-end" aria-labelledby="transactionID">
							<a class="dropdown-item" href="~/Company/Ilan/Index">Kullanıcı gözü</a>
							<a class="dropdown-item" href="~/Admin/Ilan/Index">Düzenle</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<ul class="p-0 m-0">
@* 						@foreach (var ilan in ViewBag.Ilanlar)
						{
							<li class="d-flex mb-4 pb-1">
								<div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
									<div class="me-2">
										<a href="~/Admin/Ilan/Index">
											<h6 class="mb-0">@ilan.Baslik</h6>
										</a>
									</div>
									<div class="user-progress d-flex align-items-center gap-1">
										<span class="text-muted">@ilan.Tarih.ToString("dd MMM yyyy")</span>
									</div>
								</div>
							</li>
						} *@
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>


<!-- Mesaj Görüntüleme Modalı -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="messageModalTitle"></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
			</div>
			<div class="modal-body" id="messageModalBody"></div>
			<div class="modal-footer">
				<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>

<!-- Mesaj Görüntüleme Modalı -->
<div class="modal fade" id="messageModal2" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="messageModalTitle"></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
			</div>
			<div class="modal-body">
				<p id="messageModalBody"></p>
				<hr>
				<p><strong>Cep Telefonu:</strong> <span id="modalMail"></span></p>
				<p><strong>Sabit Telefon:</strong> <span id="modalTelefonCep"></span></p>
				<p><strong>Unvan:</strong> <span id="modalTelefonSabit"></span></p>
				<p><strong>Kurum:</strong> <span id="modalUnvan"></span></p>
				<p><strong>Açıklama:</strong> <span id="modalKurum"></span></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>


<script>
	function openModal(name, message) {
		document.getElementById("messageModalTitle").innerText = name;
		document.getElementById("messageModalBody").innerText = message;
		var modal = new bootstrap.Modal(document.getElementById("messageModal"));
		modal.show();
	}
		function openModal2(isim, aciklama, mail, telefonCep, telefonSabit, unvan, kurumIsmi) {
		document.getElementById("messageModalTitle").innerText = isim;
		document.getElementById("messageModalBody").innerText = aciklama;
		document.getElementById("modalMail").innerText = mail;
		document.getElementById("modalTelefonCep").innerText = telefonCep;
		document.getElementById("modalTelefonSabit").innerText = telefonSabit;
		document.getElementById("modalUnvan").innerText = unvan;
		document.getElementById("modalKurum").innerText = kurumIsmi;

		var modal = new bootstrap.Modal(document.getElementById("messageModal2"));
		modal.show();
	}

</script>