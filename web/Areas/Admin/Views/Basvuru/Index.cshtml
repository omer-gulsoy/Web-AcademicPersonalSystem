@model List<entity.Concrate.Basvuru>
@{
	ViewData["Title"] = "Başvuru Düzenle";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Admin Paneli /</span> Başvuruları Düzenle </h4>
	<hr class="my-5" />
	<!-- Tablo -->
	<div class="card">
		<div class="card-header d-flex justify-content-between">
			<h5>Başvurular</h5>
		</div>
		<div class="card-body">
			<div class="table-responsive text-nowrap">
				<table class="table table-bordered">
					<thead>
						<tr style="text-align:center">
							<th><b>İLAN</b></th>
							<th style="width: 80px;"><b>UNVAN</b></th>
							<th><b>İSİM</b></th>
							<th><b>SOYİSİM</b></th>
							<th style="width: 100px;"><b>DİĞER BİLGİLER</b></th>
							<th style="width: 80px;"><b>STATÜ</b></th>
							<th style="width: 80px;"><b>YÖNLENDİR</b></th>
							<th style="width: 80px;"><b>DÜZENLE</b></th>
							<th style="width: 80px;"><b>SİL</b></th>
						</tr>
					</thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="text-align:center">

                                <td>
									<button class="btn btn-primary onclick="showPopup('short', @item.Basvuru_Id)">
                                        Görüntüle
                                    </button>
                                </td>
                                <td>@item.Personel?.Unvan?.Isim</td>
                                <td>@item.Personel?.Isim</td>
                                <td>@item.Personel?.Soyisim</td>
                                <td>
                                    <button class="btn btn-primary ">
                                        Görüntüle
                                    </button>
                                </td>
                                <td>@item.BasvuruStatu?.Statu</td>

								<td>
									<a class="btn" href="/Admin/Yonlendir/Index/@item.Basvuru_Id">
										<i class="bx bx-user-plus"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="editBasvuru(@item.Basvuru_Id)">
										<i class="bx bx-edit"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="deleteBasvuru(@item.Basvuru_Id)">
										<i class="bx bx-trash"></i>
									</a>
								</td>
                            </tr>
                        }
                    </tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- Servis Güncelleme Modalı -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Başvuru Güncelle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="editBasvuruId">
				<div class="mb-3">
					<label for="editIlanId" class="form-label">İlan ID</label>
					<input type="text" class="form-control" id="editIlanId" placeholder="Başlık girin">
				</div>
				<div class="mb-3">
					<label for="editTarih" class="form-label">Tarih</label>
					<textarea class="form-control" id="editTarih" placeholder="Tarih girin"></textarea>
				</div>
				<div class="mb-3">
					<label for="editBasvuruStatuId" class="form-label">Stuts</label>
					<input type="text" class="form-control" id="editBasvuruStatuId" placeholder="Bağlantı Adresi girin">
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
				<button type="button" class="btn btn-primary" onclick="saveEdit()">Kaydet</button>
			</div>
		</div>
	</div>
</div>

<!-- Popup Modal -->
<div class="modal fade" id="popupModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Başvuru Açıklama</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
			</div>
			<div class="modal-body" id="popupContent"></div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>

<!-- Confirm Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-sm modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-body" id="confirmModalMessage">Emin misiniz?</div>
			<div class="modal-footer p-2 d-flex justify-content-center">
				<button type="button" class="btn btn-success btn-sm" id="confirmYes">Evet</button>
				<button type="button" class="btn btn-danger btn-sm" id="confirmNo">Hayır</button>
			</div>
		</div>
	</div>
</div>

<!-- Toast Container -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>



<script>

	//OK

	// Toast Gösterme Fonksiyonu
	function showToast(message) {
		const toastContainer = document.getElementById('toast-container');

		const toast = document.createElement('div');
		toast.textContent = message;
		toast.style.backgroundColor = '#1e9d4b';
		toast.style.color = 'white';
		toast.style.padding = '10px 20px';
		toast.style.marginTop = '10px';
		toast.style.borderRadius = '8px';
		toast.style.boxShadow = '0 2px 6px rgba(0,0,0,0.2)';
		toast.style.fontSize = '16px';
		toast.style.opacity = '1';
		toast.style.transition = 'opacity 0.5s ease';

		toastContainer.appendChild(toast);

		// Daha uzun süre göstermek için timeout'u arttıralım (10 saniye örneği)
		const displayDuration = 10000; // 10 saniye

		setTimeout(() => {
			toast.style.opacity = '0';
			setTimeout(() => {
				toast.remove();
			}, 500); // Fade out süresi (0.5 saniye)
		}, displayDuration);
	}

	// Confirm Fonksiyonu
	function showConfirm(message, onConfirm) {
		const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
		document.getElementById('confirmModalMessage').innerText = message;

		const yesBtn = document.getElementById('confirmYes');
		const noBtn = document.getElementById('confirmNo');

		// Önce eski event listenerları temizleyelim
		yesBtn.onclick = () => {
			onConfirm(true);
			modal.hide();
		};
		noBtn.onclick = () => {
			onConfirm(false);
			modal.hide();
		};

		modal.show();
	}

	// Başvuru silen fonksiyon (confirm yerine custom confirm kullanıyor)
	function deleteBasvuru(basvuruId) {
		showConfirm("Bu başv silmek istediğinizden emin misiniz?", function (result) {
			if (result) {
				fetch(`/Admin/Basvuru/BasvuruDelete`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: `id=${basvuruId}`
				})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						showToast("Başvuru başarıyla silindi!");
						location.reload();
					} else {
						showToast("Silme işlemi başarısız!");
					}
				})
				.catch(error => {
					console.error('Silme Hatası:', error);
					showToast("Sunucu hatası oluştu!");
				});
			}
		});
	}


	//NOK

	// Popup içeriğini açan fonksiyon
	function showPopup(type, basvuruId) {
		fetch(`/Admin/Basvuru/BasvuruGet/${basvuruId}`)
			.then(response => response.json())
			.then(data => {
				console.log("Popup'a gelen veri:", data);
				let content = type === 'short'
					? (data.aciklama?.trim()?.length ? data.aciklama : "Kısa açıklama bulunamadı.")
					: (data.tarih?.trim()?.length ? data.tarih : "Açıklama bulunamadı.");

				openPopup(content);
			})
			.catch(error => console.error("Hata:", error));
	}

	// Popup açan yardımcı fonksiyon
	function openPopup(content) {
		const popupContent = document.getElementById("popupContent");
		popupContent.innerHTML = content;
		new bootstrap.Modal(document.getElementById("popupModal")).show();
	}

	// Başvuru düzenlemek için verileri çeken fonksiyon
	function editBasvuru(basvuruId) {
		fetch(`/Admin/Basvuru/BasvuruGet/${basvuruId}`)
			.then(response => {
				if (!response.ok) {
					throw new Error("Başvuru bilgileri alınamadı");
				}
				return response.json();
			})
			.then(data => {
				document.getElementById("editBasvuruId").value = data.basvuru_Id || "";
				document.getElementById("editIlanId").value = data.ilan_Id || "";
				document.getElementById("editPersonelId").value = data.personel_Id || "";
				document.getElementById("editBasvuruStatuId").value = data.basvuruStatu_Id || "";

				new bootstrap.Modal(document.getElementById("updateModal")).show();
			})
			.catch(error => console.error("Hata:", error));
	}

	// Başvuru güncelleyen fonksiyon
	function saveEdit() {
		var basvuruId = document.getElementById("editBasvuruId").value;
		var updatedData = {
			Basvuru_Id: parseInt(basvuruId),
			Ilan_Id: document.getElementById("Ilan_Id").value,
			Personel_Id: document.getElementById("editPersonel_Id").value,
			BasvuruStatu_Id: document.getElementById("editBasvuruStatu_Id").value,
		};

		fetch(`/Admin/Basvuru/BasvuruUpdate`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(updatedData)
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				showToast("Başvuru başarıyla güncellendi!");
				location.reload();
			} else {
				showToast("Güncelleme başarısız!");
			}
		})
		.catch(error => {
			console.error("Güncelleme Hata:", error);
			showToast("Sunucu hatası oluştu!");
		});

		var myModal = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
		myModal.hide();
	}

	// Add Modal açılınca form temizleme
	document.getElementById('addBasvuruModal')?.addEventListener('show.bs.modal', function (event) {
		document.getElementById('basvuruForm')?.reset();
	});

</script>