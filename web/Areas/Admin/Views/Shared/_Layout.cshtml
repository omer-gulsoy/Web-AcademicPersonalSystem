<!DOCTYPE html>
<html lang="en-US">
@await Html.PartialAsync("Components/_HeadPartial")
@RenderSection("Scripts", required: false)

<body>
	@await Html.PartialAsync("Components/_NavbarPartial")

	<div class="container-xxl flex-grow-1 container-p-y">
		<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Admin Paneli /</span> @ViewData["Title"]</h4>
		<hr class="my-5" />
		@RenderBody()
	</div>
	@await Html.PartialAsync("Components/_FooterPartial")
	@await Html.PartialAsync("Components/_ScriptPartial")
</body>
</html>