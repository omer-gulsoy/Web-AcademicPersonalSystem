@model List<dto.viewmodels.BasvuruJuriViewModel>
@{
	ViewData["Title"] = "Başvuru Değerlendir";
	Layout = "~/Areas/Juri/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
	<div class="row">
		<div class="col-12 col-lg-12 mb-4">
			<div class="card">
				<h5 class="card-header">Başvuru Listesi</h5>
				<div class="table-responsive text-nowrap">
					<table class="table table-striped text-center">
						<thead>
							<tr>
								<th>İSİM SOYİSİM</th>
								<th>E-POSTA</th>
								<th>TELEFON</th>
								<th>BAŞVURDUĞU İLAN</th>
								<th>DEĞERLENDİRME BELGESİ</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>@item.Isim @item.Soyisim</td>
									<td><a href="mailto:@item.Eposta">@item.Eposta</a></td>
									<td><a href="tel:@item.Telefon">@item.Telefon</a></td>
									<td>@item.IlanBaslik</td>
									<td>
										<form action="~/Juri/Degerlendir/Index" method="post" enctype="multipart/form-data">
											<input type="hidden" name="Basvuru_Id" value="@item.BasvuruId" />
											<div class="d-flex align-items-center gap-2">
												<div class="form-group mb-0">
													<input type="file" name="resim" class="form-control" />
												</div>
												<div class="form-group mb-0">
													<button type="submit" class="btn btn-primary">Kaydet</button>
												</div>
											</div>

										</form>
									</td>
								</tr>
							}

						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
