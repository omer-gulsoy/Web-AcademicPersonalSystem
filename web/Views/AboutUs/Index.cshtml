@{
	ViewData["Title"] = "Hakkımızda";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--==================================================-->
<!----- Start Techno About Area ----->
<!--==================================================-->
<div class="about_area pt-85 pb-100">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 col-md-6 col-sm-12 col-xs-6">
				<div class="single_about_thumb mb-3">
					<div class="single_about_thumb_inner">
						<img src="~/templates/assets/images/about1.jpg" alt="Kocaeli Üniversitesi Akademik Başvuru Sistemi" />
					</div>
				</div>
				<div class="single_about_shape">
					<div class="single_about_shape_thumb bounce-animate">
						<img src="~/templates/assets/images/about-circle.png" alt="" />
					</div>
				</div>
			</div>
			<div class="col-lg-6 col-md-6 col-sm-12 col-xs-6">
				<div class="section_title text_left mb-40 mt-3">
					<div class="section_sub_title uppercase mb-3">
						<h6>HAKKIMIZDA</h6>
					</div>
					<div class="section_main_title">
						<h1>Kocaeli Üniversitesi</h1>
						<h1>Akademik <span>Başvuru Sistemi</span></h1>
					</div>
					<div class="em_bar">
						<div class="em_bar_bg"></div>
					</div>
					<div class="section_content_text pt-4">
						<p>
							Kocaeli Üniversitesi olarak akademik personel alım süreçlerini daha sistematik ve şeffaf bir hale getirmek amacıyla Akademik Personel Başvuru Sistemini geliştirdik. Bu platform, akademik kadrolara başvurmak isteyen adaylar için hızlı, güvenilir ve kullanıcı dostu bir deneyim sunmaktadır.
						</p>
						<p>
							Sistemimiz sayesinde adaylar, açık akademik ilanları görüntüleyebilir, başvurularını tamamlayabilir ve değerlendirme süreçlerini takip edebilirler. Jüri üyeleri ve yöneticiler ise başvuruları dijital ortamda inceleyerek değerlendirme sürecini daha etkin bir şekilde yönetebilir.
						</p>
					</div>
				</div>
				<div class="singel_about_left mb-30">
					<div class="singel_about_left_inner mb-3">
						<div class="about_icon mr-4">
							<div class="icon mt-3">
								<i class="flaticon-padlock"></i>
							</div>
						</div>
						<div class="singel-about-content">
							<h5>Güvenli ve Şeffaf İşleyiş</h5>
							<p>
								Kocaeli Üniversitesi Akademik Personel Başvuru Sistemi, başvuruların güvenli şekilde saklanmasını ve yalnızca yetkili jüri üyeleri tarafından değerlendirilmesini sağlar.
							</p>
						</div>
					</div>
					<div class="singel_about_left_inner">
						<div class="about_icon mr-4">
							<div class="icon mt-3">
								<i class="flaticon-code"></i>
							</div>
						</div>
						<div class="singel-about-content">
							<h5>Hızlı ve Kolay Başvuru</h5>
							<p>
								Kullanıcı dostu arayüzümüz sayesinde adaylar başvurularını kolayca tamamlayabilir ve süreci adım adım takip edebilirler.
							</p>
						</div>
					</div>
					<div class="singel_about_left_inner">
						<div class="about_icon mr-4">
							<div class="icon mt-3">
								<i class="flaticon-document"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!--==================================================-->
<!----- End Techno About Area ----->
<!--==================================================-->
<!--==================================================-->
<!----- Start Techno Call Do Action Area ----->	
<!--==================================================-->
<div class="call_do_action pt-85 pb-130 bg_color"
	 style="background-image: url('@Url.Content("~/templates/assets/images/slider/slider-6.jpg")')">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="section_title white text_center mb-60 mt-3">
					<div class="phone_number mb-3">
						<h5>İletişim: +90 262 123 45 67</h5>
					</div>
					<div class="section_main_title">
						<h1>Akademik Kariyerinize</h1>
						<h1>Bir Adım Daha Yaklaşın</h1>
					</div>
					<div class="button three mt-40">
						<a href="#">
							Hemen Başvur<i class="fa fa-long-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!--==================================================-->
<!----- End Techno Call Do Action Area ----->
<!--==================================================-->
<!--==================================================-->
<!----- Start Techno Counter Area ----->
<!--==================================================-->
<div class="counter_area">
	<div class="container">
		<div class="row cntr_bg_up nagative_margin pt-50 pb-45">
			<div class="col-lg-3 col-md-6 col-sm-12">
				<div class="single_counter text_center mb-4">
					<div class="countr_text">
						<h1><span class="counter">15</span><span>K</span></h1>
					</div>
					<div class="counter_desc">
						<h5>Başvuru Yapan Adaylar</h5>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12">
				<div class="single_counter text_center mb-4">
					<div class="countr_text">
						<h1><span class="counter">1280</span><span>+</span></h1>
					</div>
					<div class="counter_desc">
						<h5>Değerlendirilen Başvurular</h5>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12">
				<div class="single_counter text_center mb-4">
					<div class="countr_text">
						<h1><span class="counter">10</span><span>K</span></h1>
					</div>
					<div class="counter_desc">
						<h5>Onaylanan Adaylar</h5>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12">
				<div class="single_counter text_center mb-4">
					<div class="countr_text">
						<h1><span class="counter">992</span><span>+</span></h1>
					</div>
					<div class="counter_desc">
						<h5>Atanan Akademisyenler</h5>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!--==================================================-->
<!----- End Techno Counter Area ----->
<!--==================================================-->
<!--==================================================-->
<!----- Start Techno Service Area ----->
<!--==================================================-->
<div class="service_area pt-85 pb-70">
	<div class="container">
		<div class="row">
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>01</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Akademik İlanlar</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Mevcut akademik kadro ilanlarını inceleyin
								ve uygun pozisyonlara başvurun.
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>02</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Kolay ve Hızlı Başvuru</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Başvuru sürecinizi hızlıca tamamlayın
								ve tüm belgelerinizi yükleyin.
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>03</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Şeffaf Değerlendirme</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Başvurular jüri tarafından incelenir
								ve objektif olarak değerlendirilir.
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>04</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Online Belge Yükleme</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Gerekli belgeleri kolayca sisteme yükleyin
								ve başvurunuzu tamamlayın.
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>05</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Başvuru Takibi</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Başvurunuzun durumunu takip edin
								ve süreç hakkında bilgi alın.
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="service_style_two mb-4">
					<div class="service_style_two_number mr-60">
						<h5>06</h5>
					</div>
					<div class="service_style_two_content">
						<div class="service_style_two_title pb-3">
							<h4>Kocaeli Üniversitesi</h4>
						</div>
						<div class="service_style_two_text">
							<p>
								Kocaeli Üniversitesi güvencesiyle
								akademik kariyerinize yön verin.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<!--==================================================-->
<!----- End Techno Service Area ----->
<!--==================================================-->