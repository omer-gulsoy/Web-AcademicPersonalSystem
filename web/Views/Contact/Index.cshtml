<!--==================================================-->
<!----- Start Techno Contact Area ----->
<!--==================================================-->
<div class="appointment_form pb-100">
	<div class="container">
		<div class="row nagative_margin">
			<div class="col-xl-12">
				<div class="appointment_form_inner">
					<div class="appointment_title pb-35">
						<h1>BİZE ULAŞIN</h1>
					</div>
					<form id="contact_form"
						  action="https://formspree.io/f/myyleorq"
						  method="POST"
						  id="dreamit-form">
						<div class="row">
							<div class="col-lg-6">
								<h7>İsim</h7>
								<div class="form_box mb-30">
									<input type="text" name="name" placeholder="Name" />
								</div>
							</div>
							<div class="col-lg-6">
								<h7>Soyisim</h7>
								<div class="form_box mb-30">
									<input type="text" name="name" placeholder="Name" />
								</div>
							</div>
							<div class="col-lg-6">
								<h7>E-Posta Adresi</h7>
								<div class="form_box mb-30">
									<input type="email"
										   name="email"
										   placeholder="Email Address" />
								</div>
							</div>
							<div class="col-lg-6">
								<h7>Telefon</h7>
								<div class="form_box mb-30">
									<input type="text"
										   name="phone"
										   placeholder="Phone Number" />
								</div>
							</div>

							<div class="col-lg-12">
								<div class="form_box mb-30">
									<textarea name="message"
											  id="message"
											  cols="30"
											  rows="10"
											  placeholder="Mesajınızı yazınız"></textarea>
								</div>
								<div class="quote_btn text_center">
									<button class="btn" type="submit">Gönder</button>
								</div>
							</div>
						</div>
					</form>
					<div class="status"></div>
				</div>
			</div>
		</div>
	</div>
</div>
<!--==================================================-->
<!----- End Techno Contact Area ----->
<!--==================================================-->