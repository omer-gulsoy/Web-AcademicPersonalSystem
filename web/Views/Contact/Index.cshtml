@model entity.Concrate.Contact
@{
	ViewData["Title"] = "İletişim";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="contact-us" id="contact">
	<div class="container">
		<div class="row">
			<div class="col-lg-9 align-self-center">
				<div class="row">
					<div class="col-lg-12">
						<form id="contact" action="" method="post">
							<div class="row">
								<div class="col-lg-12">
									<h2>BİZİMLE İLETİŞİME GEÇİN</h2>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input Asp-For="Isim" name="Isim" id="isim" type="text" placeholder="İsminiz" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input Asp-For="Soyisim" name="Soyisim" id="soyisim" type="text" placeholder="Soyisminiz" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input Asp-For="Eposta" type="text" id="email" pattern="[^ ]*[^ ]*" placeholder="E-Posta Adresiniz" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input Asp-For="Konu" name="Konu" id="konu" type="text" placeholder="İleti Konunuz" required="">
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<textarea Asp-For="Mesaj" type="text" class="form-control" id="message" placeholder="İletiniz" required=""></textarea>
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<button type="submit" id="form-submit" class="button">GÖNDER</button>
									</fieldset>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
			<div class="col-lg-3">
				<div class="right-info">
					<ul>
						<li>
							<h6>Telefon Numaramız</h6>
							<a href="tel:+902623031000"><span>+90(262)303 10 00</span></a>
						</li>
						<li>
							<h6>E-Posta Adresimiz</h6>
							<a href="mailto:kurumsaliletisim@kocaeli.edu.tr"><span>ogrenci@kocaeli.edu.tr</span></a>
						</li>
						<li>
							<h6>Adresimiz</h6>
							<a><span>Kabaoğlu, Baki Komsuoğlu bulvarı No:515, Umuttepe, 41001 İzmit/Kocaeli</span></a>
						</li>
						<li>
							<h6>Resmi Sitemiz</h6>
							<a href="https://www.kocaeli.edu.tr/"><span>www.kocaeli.edu.tr</span></a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>


<script>
	$(document).ready(function () {
		var msg = '@ViewBag.Message';
		if (msg) {
			toastr.success(msg);
		}
	});


	$(document).ready(function () {

		function formatName(text) {
			return text
				.split(" ")
				.filter(p => p.trim() !== "")
				.map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
				.join(" ");
		}

		function formatSurname(text) {
			return text.toUpperCase();
		}

		function formatSubject(text) {
			return text
				.split(" ")
				.filter(p => p.trim() !== "")
				.map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
				.join(" ");
		}

		$("#isim").on("input", function () {
			let caret = this.selectionStart;
			this.value = formatName(this.value);
			this.setSelectionRange(caret, caret);
		});

		$("#soyisim").on("input", function () {
			let caret = this.selectionStart;
			this.value = formatSurname(this.value);
			this.setSelectionRange(caret, caret);
		});

		$("#konu").on("input", function () {
			let caret = this.selectionStart;
			this.value = formatSubject(this.value);
			this.setSelectionRange(caret, caret);
		});
	});
</script>
