@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<!--==================================================-->
<!-- Start Techno Slider Area -->
<!--==================================================-->
<div class="slider_list owl-carousel">
	<div class="slider_area d-flex align-items-center slider1" id="home">
		<div class="container">
			<div class="row">
				<!--Start Single Portfolio -->
				<div class="col-lg-12">
					<div class="single_slider">
						<div class="slider_content">
							<div class="slider_text">
								<div class="slider_text_inner">
									<h5></h5>
									<h1>Akademik Personel Başvuru</h1>
									<h1>Süreçlerinizi Dijitalleştirin</h1>
								</div>
								<div class="slider_button pt-5 d-flex">
									<div class="button">
										<a href="~/Login/Index">
											Giriş Yap <i class="fa fa-long-arrow-right"></i>
										</a>
										<a class="active" href="~/Register/Index">
											Kaydol <i class="fa fa-long-arrow-right"></i>
										</a>
									</div>
								</div>
								<div class="slider-video">
									<div class="video-icon">
										<a class="video-vemo-icon venobox vbox-item"
										   data-vbtype="youtube"
										   data-autoplay="true"
										   href="https://youtu.be/BS4TUd7FJSg">
											<i class="fa fa-play"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="slider_area d-flex align-items-center slider2">
		<div class="container">
			<div class="row">
				<!--Start Single Portfolio -->
				<div class="col-lg-12">
					<div class="single_slider">
						<div class="slider_content">
							<div class="slider_text">
								<div class="slider_text_inner">
									<h5></h5>
									<h1>Akademik Personel Başvuru</h1>
									<h1>Süreçlerinizi Dijitalleştirin</h1>
								</div>
								
								<div class="slider_button pt-5 d-flex">
									<div class="button">
										<a href="~/Login/Index">
											Giriş Yap <i class="fa fa-long-arrow-right"></i>
										</a>
										<a class="active" href="~/Register/Index">
											Kaydol <i class="fa fa-long-arrow-right"></i>
										</a>
									</div>
								</div>
								<div class="slider-video">
									<div class="video-icon">
										<a class="video-vemo-icon venobox vbox-item"
										   data-vbtype="youtube"
										   data-autoplay="true"
										   href="https://youtu.be/BS4TUd7FJSg">
											<i class="fa fa-play"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!--==================================================-->
<!-- End Techno Slider Area -->
<!--==================================================-->
<!--==================================================-->
<!-- Start Techno Flipbox Top Feature Area -->
<!--==================================================-->
<div class="flipbox_area top_feature">
	<div class="container">
		<div class="row nagative_margin">
			<div class="col-lg-3 col-md-6 col-sm-12 col-xs-6">
				<div class="techno_flipbox mb-30">
					<div class="techno_flipbox_font">
						<div class="techno_flipbox_inner">
							<div class="techno_flipbox_icon">
								<div class="icon">
									<i class="flaticon-global-1"></i>
								</div>
							</div>
							<div class="flipbox_title">
								<h3>Akademik Kadro İlanları</h3>
							</div>
						</div>
					</div>
					<div class="techno_flipbox_back">
						<div class="techno_flipbox_inner">
							<div class="flipbox_title">
								<h3>Akademik Kadro İlanları</h3>
							</div>
							<div class="flipbox_desc">
								<p>
									Açık akademik kadro ilanlarını görüntüleyin ve başvuru süreçlerini yönetin.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12 col-xs-6">
				<div class="techno_flipbox mb-30">
					<div class="techno_flipbox_font">
						<div class="techno_flipbox_inner">
							<div class="techno_flipbox_icon">
								<div class="icon">
									<i class="flaticon-data"></i>
								</div>
							</div>
							<div class="flipbox_title">
								<h3>Başvuru Süreci</h3>
							</div>
						</div>
					</div>
					<div class="techno_flipbox_back">
						<div class="techno_flipbox_inner">
							<div class="flipbox_title">
								<h3>Başvuru Süreci</h3>
							</div>
							<div class="flipbox_desc">
								<p>
									Aday olarak giriş yapın, ilanları inceleyin ve gerekli belgeleri sisteme yükleyerek başvurunuzu tamamlayın.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12 col-xs-6">
				<div class="techno_flipbox mb-30">
					<div class="techno_flipbox_font">
						<div class="techno_flipbox_inner">
							<div class="techno_flipbox_icon">
								<div class="icon">
									<i class="flaticon-interaction"></i>
								</div>
							</div>
							<div class="flipbox_title">
								<h3>Değerlendirme ve Jüri Süreci</h3>
							</div>
						</div>
					</div>
					<div class="techno_flipbox_back">
						<div class="techno_flipbox_inner">
							<div class="flipbox_title">
								<h3>Değerlendirme ve Jüri Süreci</h3>
							</div>
							<div class="flipbox_desc">
								<p>
									Jüri üyeleri başvuruları inceler, değerlendirme raporlarını oluşturur ve adayları değerlendirir.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6 col-sm-12 col-xs-6">
				<div class="techno_flipbox mb-30">
					<div class="techno_flipbox_font">
						<div class="techno_flipbox_inner">
							<div class="techno_flipbox_icon">
								<div class="icon">
									<i class="flaticon-developer"></i>
								</div>
							</div>
							<div class="flipbox_title">
								<h3>Sonuç ve Bildirimler</h3>
							</div>
						</div>
					</div>
					<div class="techno_flipbox_back">
						<div class="techno_flipbox_inner">
							<div class="flipbox_title">
								<h3>Sonuç ve Bildirimler</h3>
							</div>
							<div class="flipbox_desc">
								<p>
									Adaylar başvurularının durumunu takip edebilir ve sonuçları sistem üzerinden öğrenebilir.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!--==================================================-->
<!-- End Techno Flipbox Top Feature Area -->
<!--==================================================-->
<!--==================================================-->
<!----- Start Techno About Area ----->
<!--==================================================-->
<div class="about_area pt-70 pb-100">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 col-md-6 col-sm-12 col-xs-6">
				<div class="single_about_thumb mb-3">
					<div class="single_about_thumb_inner">
						<img src="~/templates/assets/images/about-img.png" alt="Akademik Başvuru Sistemi" />
					</div>
				</div>
				<div class="single_about_shape">
					<div class="single_about_shape_thumb bounce-animate">
						<img src="~/templates/assets/images/about-circle.png" alt="" />
					</div>
				</div>
			</div>
			<div class="col-lg-6 col-md-6 col-sm-12 col-xs-6">
				<div class="section_title text_left mb-40 mt-3">
					<div class="section_sub_title uppercase mb-3">
						<h6>AKADEMİK PERSONEL BAŞVURU SİSTEMİ</h6>
					</div>
					<div class="section_main_title">
						<h1>Akademik Kariyeriniz İçin</h1>
						<h1>En İyi <span>Başvuru Platformu</span></h1>
					</div>
					<div class="em_bar">
						<div class="em_bar_bg"></div>
					</div>
					<div class="section_content_text pt-4">
						<p>
							Açık akademik kadrolara kolayca başvurabilir, süreçleri takip edebilir ve değerlendirme sonuçlarını öğrenebilirsiniz.
						</p>
					</div>
				</div>
				<div class="singel_about_left mb-30">
					<div class="singel_about_left_inner mb-3">
						<div class="about_icon mr-4">
							<div class="icon mt-3">
								<i class="flaticon-padlock"></i>
							</div>
						</div>
						<div class="singel-about-content">
							<h5>Güvenli Başvuru Sistemi</h5>
							<p>
								Tüm başvurularınız güvenli şekilde saklanır ve sadece yetkili jüri üyeleri tarafından incelenir.
							</p>
						</div>
					</div>
					<div class="singel_about_left_inner">
						<div class="about_icon mr-4">
							<div class="icon mt-3">
								<i class="flaticon-code"></i>
							</div>
						</div>
						<div class="singel-about-content">
							<h5>Şeffaf Değerlendirme Süreci</h5>
							<p>
								Başvurularınız belirlenen kriterlere göre değerlendirilir ve sonuçlar sistem üzerinden duyurulur.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!--==================================================-->
<!-- End Techno About Area -->
<!--==================================================-->
