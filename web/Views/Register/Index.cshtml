@using dto.dtos.AppUserDtos
@model AppUserRegisterDto
@{
	ViewData["Title"] = "Kaydol";
	Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<section class="contact-us" id="contact">
	<div class="container">
		<div class="row mt-5">
			<div class="col-lg-4 align-self-center mx-auto">
				<div class="row">
					<div class="col-lg-12">
						<form id="contact" method="post">
							<div class="row">
								<div class="col-lg-12">
									<h2 style="color:#1e9d4b;text-align:center"><b>KAYDOL</b></h2>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="Name" type="text" id="isim" placeholder="İsminiz">
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="Surname" type="text" id="soyisim" placeholder="Soyisminiz" >
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="UserName" type="text" id="tc" placeholder="T.C. Kimlik Numaranız" required maxlength="11" inputmode="numeric">
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="Email" type="email" id="email" placeholder="E-Posta Adresiniz" >
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="Password" type="password" placeholder="Parolanız" required="">
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<input asp-for="ConfirmPassword" type="password" placeholder="Parolanızı Tekrar Giriniz" required="">
									</fieldset>
								</div>
								<div class="col-lg-12 d-flex align-items-center justify-content-center">
									<fieldset>
										<button type="submit" id="form-submit" class="button">KAYDOL</button>
									</fieldset>
								</div>

								<div class="col-lg-12 col-sm-7 mt-3">
									<div class="left-content">
										<p style="text-align:center">Hesabınız var mı? <a href="/Login/Index">Giriş Yapın.</a></p>
									</div>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>